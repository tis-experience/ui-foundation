{
  "$schema": "../schemas/component-contracts.schema.json",
  "version": "0.1.0-alpha.0",
  "profiles": {
    "action": {
      "classification": "action",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "intrinsic",
      "requiredStates": ["default", "disabled", "focus-visible"],
      "consumerResponsibilities": ["Provide an accessible name", "Choose button or link semantics from the intended action"]
    },
    "action-group": {
      "classification": "action",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "consumer-managed-horizontal",
      "requiredStates": ["default", "disabled", "focus-visible", "selected"],
      "consumerResponsibilities": ["Provide a group label", "Keep the action order meaningful"]
    },
    "data-display": {
      "classification": "data-display",
      "behaviorOwner": "library",
      "keyboard": "not-applicable",
      "responsive": "consumer-layout",
      "requiredStates": ["default"],
      "consumerResponsibilities": ["Provide meaningful content and alternatives for non-text information"]
    },
    "data-table": {
      "classification": "data-display",
      "behaviorOwner": "external",
      "keyboard": "composed",
      "responsive": "consumer-managed-horizontal",
      "requiredStates": ["default", "empty", "loading", "selected"],
      "consumerResponsibilities": ["Provide column labels", "Own sorting, filtering, pagination and data state"]
    },
    "data-visualization": {
      "classification": "data-display",
      "behaviorOwner": "external",
      "keyboard": "composed",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "empty", "loading"],
      "consumerResponsibilities": ["Provide a concise text summary", "Provide exact values in a table when the task requires them"]
    },
    "disclosure": {
      "classification": "disclosure",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "intrinsic",
      "requiredStates": ["collapsed", "expanded", "disabled", "focus-visible"],
      "consumerResponsibilities": ["Use concise trigger labels", "Keep hidden content understandable when revealed"]
    },
    "external-control": {
      "classification": "form-control",
      "behaviorOwner": "external",
      "keyboard": "managed",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "disabled", "focus-visible", "invalid"],
      "consumerResponsibilities": ["Compose a visible label and error description", "Own value, validation and submission"]
    },
    "external-interactive": {
      "classification": "interactive-composition",
      "behaviorOwner": "external",
      "keyboard": "managed",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "disabled", "focus-visible"],
      "consumerResponsibilities": ["Provide accessible names", "Own application data and side effects"]
    },
    "form-composition": {
      "classification": "form-control",
      "behaviorOwner": "library",
      "keyboard": "composed",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "disabled", "focus-visible", "invalid", "read-only"],
      "consumerResponsibilities": ["Compose visible labels, descriptions and errors", "Own value, validation and submission"]
    },
    "form-structure": {
      "classification": "form-structure",
      "behaviorOwner": "library",
      "keyboard": "not-applicable",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "disabled", "invalid", "read-only"],
      "consumerResponsibilities": ["Maintain stable IDs and label relationships", "Connect descriptions and errors with aria-describedby"]
    },
    "live-feedback": {
      "classification": "feedback",
      "behaviorOwner": "base-ui",
      "keyboard": "composed",
      "responsive": "viewport-constrained",
      "requiredStates": ["default", "success", "warning", "error"],
      "consumerResponsibilities": ["Use the correct urgency", "Keep dismiss and action labels explicit"]
    },
    "external-live-feedback": {
      "classification": "feedback",
      "behaviorOwner": "external",
      "keyboard": "composed",
      "responsive": "viewport-constrained",
      "requiredStates": ["default", "success", "warning", "error"],
      "consumerResponsibilities": ["Use the correct urgency", "Keep dismiss and action labels explicit"]
    },
    "menu": {
      "classification": "navigation",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "viewport-constrained",
      "requiredStates": ["closed", "open", "disabled", "focus-visible", "selected"],
      "consumerResponsibilities": ["Use menus for actions rather than arbitrary form values", "Provide meaningful item labels"]
    },
    "modal-overlay": {
      "classification": "overlay",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "viewport-constrained",
      "requiredStates": ["closed", "open", "focus-visible"],
      "consumerResponsibilities": ["Provide a title and description", "Provide a clear close or decision path"]
    },
    "native-control": {
      "classification": "form-control",
      "behaviorOwner": "browser",
      "keyboard": "native",
      "responsive": "intrinsic",
      "requiredStates": ["default", "disabled", "focus-visible", "invalid", "read-only"],
      "consumerResponsibilities": ["Compose a visible label and error description", "Own value, validation and submission"]
    },
    "navigation": {
      "classification": "navigation",
      "behaviorOwner": "library",
      "keyboard": "composed",
      "responsive": "consumer-managed-horizontal",
      "requiredStates": ["default", "current", "disabled", "focus-visible"],
      "consumerResponsibilities": ["Provide a navigation label when multiple regions exist", "Own routes and destination state"]
    },
    "navigation-overlay": {
      "classification": "navigation",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "viewport-constrained",
      "requiredStates": ["closed", "open", "current", "focus-visible"],
      "consumerResponsibilities": ["Use real links for destinations", "Provide meaningful trigger and link labels"]
    },
    "nonmodal-overlay": {
      "classification": "overlay",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "viewport-constrained",
      "requiredStates": ["closed", "open", "focus-visible"],
      "consumerResponsibilities": ["Provide an accessible trigger name", "Keep essential information available without relying only on the overlay"]
    },
    "scroll-surface": {
      "classification": "layout",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "scroll-contained",
      "requiredStates": ["default", "focus-visible", "overflowing"],
      "consumerResponsibilities": ["Provide a constrained size", "Do not hide essential actions outside the initial viewport"]
    },
    "selection-control": {
      "classification": "form-control",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "intrinsic",
      "requiredStates": ["default", "disabled", "focus-visible", "invalid", "selected"],
      "consumerResponsibilities": ["Compose a visible label and error description", "Own value, validation and submission"]
    },
    "static-feedback": {
      "classification": "feedback",
      "behaviorOwner": "library",
      "keyboard": "not-applicable",
      "responsive": "consumer-layout",
      "requiredStates": ["default", "success", "warning", "error"],
      "consumerResponsibilities": ["Choose status or alert semantics from urgency", "Provide actionable recovery copy when applicable"]
    },
    "status": {
      "classification": "feedback",
      "behaviorOwner": "base-ui",
      "keyboard": "not-applicable",
      "responsive": "intrinsic",
      "requiredStates": ["default", "loading", "complete"],
      "consumerResponsibilities": ["Provide an accessible name", "Expose determinate values when known"]
    },
    "passive-status": {
      "classification": "feedback",
      "behaviorOwner": "library",
      "keyboard": "not-applicable",
      "responsive": "intrinsic",
      "requiredStates": ["default", "loading", "complete"],
      "consumerResponsibilities": ["Provide an accessible status name when progress is not already described nearby", "Avoid announcing decorative loading placeholders"]
    },
    "tabs": {
      "classification": "navigation",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "consumer-managed-horizontal",
      "requiredStates": ["default", "selected", "disabled", "focus-visible"],
      "consumerResponsibilities": ["Use concise tab labels", "Keep each panel associated with its tab"]
    },
    "text-control": {
      "classification": "form-control",
      "behaviorOwner": "base-ui",
      "keyboard": "native",
      "responsive": "intrinsic",
      "requiredStates": ["default", "disabled", "focus-visible", "invalid", "read-only"],
      "consumerResponsibilities": ["Compose a visible label and error description", "Own value, validation and submission"]
    },
    "toggle-action": {
      "classification": "action",
      "behaviorOwner": "base-ui",
      "keyboard": "managed",
      "responsive": "intrinsic",
      "requiredStates": ["default", "disabled", "focus-visible", "selected"],
      "consumerResponsibilities": ["Provide an accessible name", "Expose pressed state without relying on color alone"]
    },
    "utility": {
      "classification": "utility",
      "behaviorOwner": "base-ui",
      "keyboard": "not-applicable",
      "responsive": "intrinsic",
      "requiredStates": ["default"],
      "consumerResponsibilities": ["Apply only at an intentional application boundary"]
    }
  },
  "components": {
    "accordion": "disclosure",
    "alert": "static-feedback",
    "alert-dialog": "modal-overlay",
    "aspect-ratio": "data-display",
    "attachment": "action",
    "avatar": "data-display",
    "badge": "data-display",
    "breadcrumb": "navigation",
    "bubble": "data-display",
    "button": "action",
    "button-group": "action-group",
    "calendar": "external-control",
    "card": "data-display",
    "carousel": "external-interactive",
    "chart": "data-visualization",
    "checkbox": "selection-control",
    "collapsible": "disclosure",
    "combobox": "form-composition",
    "command": "external-interactive",
    "context-menu": "menu",
    "data-table": "data-table",
    "date-picker": "form-composition",
    "dialog": "modal-overlay",
    "direction": "utility",
    "drawer": "modal-overlay",
    "dropdown-menu": "menu",
    "empty": "static-feedback",
    "field": "form-structure",
    "form": "form-structure",
    "hover-card": "nonmodal-overlay",
    "input": "text-control",
    "input-group": "form-composition",
    "input-otp": "external-control",
    "item": "data-display",
    "kbd": "data-display",
    "label": "form-structure",
    "marker": "data-display",
    "menubar": "menu",
    "message": "static-feedback",
    "message-scroller": "scroll-surface",
    "native-select": "native-control",
    "navigation-menu": "navigation-overlay",
    "pagination": "navigation",
    "popover": "nonmodal-overlay",
    "progress": "status",
    "questionnaire": "form-structure",
    "radio-group": "selection-control",
    "resizable": "external-interactive",
    "scroll-area": "scroll-surface",
    "select": "selection-control",
    "separator": "data-display",
    "sheet": "modal-overlay",
    "sidebar": "navigation",
    "skeleton": "passive-status",
    "slider": "selection-control",
    "sonner": "external-live-feedback",
    "spinner": "passive-status",
    "switch": "selection-control",
    "table": "data-display",
    "tabs": "tabs",
    "textarea": "native-control",
    "toast": "live-feedback",
    "toggle": "toggle-action",
    "toggle-group": "action-group",
    "tooltip": "nonmodal-overlay",
    "typography": "data-display"
  },
  "interactionContracts": {
    "alert-dialog": {
      "semantics": ["role=alertdialog", "name=title", "description=required"],
      "keyboardInteractions": [
        { "keys": ["Enter", "Space"], "outcome": "Open from the trigger" },
        { "keys": ["Escape"], "outcome": "Close without confirming" },
        { "keys": ["Tab", "Shift+Tab"], "outcome": "Cycle focus within the alert dialog" }
      ],
      "focusManagement": ["Move initial focus to the least destructive action", "Restore focus to the trigger after close"],
      "requiredComposition": ["Include AlertDialogTitle and AlertDialogDescription", "Provide explicit cancel and confirm actions"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/alert-dialog",
        "behavior": "https://base-ui.com/react/components/alert-dialog"
      },
      "evidence": "tests/component-contracts.spec.ts#alert-dialog"
    },
    "button": {
      "semantics": ["role=button", "name=required"],
      "keyboardInteractions": [
        { "keys": ["Enter", "Space"], "outcome": "Activate the action exactly once" }
      ],
      "focusManagement": ["Participate in native tab order when enabled", "Expose a visible focus indicator"],
      "requiredComposition": ["Render a button for actions and a link for navigation", "Mark decorative icons as hidden from assistive technology"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/button",
        "behavior": "https://base-ui.com/react/components/button"
      },
      "evidence": "tests/component-contracts.spec.ts#button"
    },
    "checkbox": {
      "semantics": ["role=checkbox", "name=required", "aria-checked=state"],
      "keyboardInteractions": [
        { "keys": ["Space"], "outcome": "Toggle the checked state" }
      ],
      "focusManagement": ["Keep focus on the control after toggling", "Expose a visible focus indicator"],
      "requiredComposition": ["Associate a visible label or provide an accessible name", "Connect error copy when invalid"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/checkbox",
        "behavior": "https://base-ui.com/react/components/checkbox"
      },
      "evidence": "tests/component-contracts.spec.ts#checkbox"
    },
    "context-menu": {
      "semantics": ["role=menu", "items=menuitem", "visible-alternative=required"],
      "keyboardInteractions": [
        { "keys": ["ArrowDown", "ArrowUp"], "outcome": "Move between enabled items" },
        { "keys": ["Escape"], "outcome": "Close the menu" }
      ],
      "focusManagement": ["Move focus through menu items while open", "Return focus to the visible alternative after its menu closes"],
      "requiredComposition": ["Treat the context menu as an enhancement", "Provide a visible control exposing the same actions"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/context-menu",
        "behavior": "https://base-ui.com/react/components/context-menu"
      },
      "evidence": "tests/component-contracts.spec.ts#context-menu"
    },
    "dialog": {
      "semantics": ["role=dialog", "name=title", "description=required", "background=inert"],
      "keyboardInteractions": [
        { "keys": ["Enter", "Space"], "outcome": "Open from the trigger" },
        { "keys": ["Escape"], "outcome": "Request close" },
        { "keys": ["Tab", "Shift+Tab"], "outcome": "Cycle focus within the dialog" }
      ],
      "focusManagement": ["Move focus inside on open", "Restore focus to the trigger after close"],
      "requiredComposition": ["Include DialogTitle and DialogDescription", "Provide a visible close or completion action"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/dialog",
        "behavior": "https://base-ui.com/react/components/dialog"
      },
      "evidence": "tests/component-contracts.spec.ts#dialog"
    },
    "dropdown-menu": {
      "semantics": ["role=menu", "items=menuitem", "trigger.aria-expanded=state"],
      "keyboardInteractions": [
        { "keys": ["ArrowDown", "ArrowUp"], "outcome": "Open or move between enabled items" },
        { "keys": ["Home", "End"], "outcome": "Move to the first or last enabled item" },
        { "keys": ["Escape"], "outcome": "Close the menu" }
      ],
      "focusManagement": ["Move focus to an item when opened from the keyboard", "Restore focus to the trigger after close"],
      "requiredComposition": ["Use menu items for actions and link items for destinations", "Keep labels meaningful for typeahead navigation"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/dropdown-menu",
        "behavior": "https://base-ui.com/react/components/menu"
      },
      "evidence": "tests/component-contracts.spec.ts#dropdown-menu"
    },
    "popover": {
      "semantics": ["role=dialog", "name=title", "trigger.aria-expanded=state"],
      "keyboardInteractions": [
        { "keys": ["Enter", "Space"], "outcome": "Toggle the popover from the trigger" },
        { "keys": ["Escape"], "outcome": "Close the popover" }
      ],
      "focusManagement": ["Move focus according to the interactive content", "Restore focus to the trigger after close"],
      "requiredComposition": ["Include a title when the content needs an accessible name", "Do not use for information that must remain continuously available"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/popover",
        "behavior": "https://base-ui.com/react/components/popover"
      },
      "evidence": "tests/component-contracts.spec.ts#popover"
    },
    "radio-group": {
      "semantics": ["role=radiogroup", "group-name=required", "items=radio", "aria-checked=state"],
      "keyboardInteractions": [
        { "keys": ["ArrowDown", "ArrowRight"], "outcome": "Move focus and selection to the next radio" },
        { "keys": ["ArrowUp", "ArrowLeft"], "outcome": "Move focus and selection to the previous radio" }
      ],
      "focusManagement": ["Use roving focus within the group", "Expose a visible focus indicator on the active radio"],
      "requiredComposition": ["Provide a programmatic group label", "Associate a visible label with every radio"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/radio-group",
        "behavior": "https://base-ui.com/react/components/radio-group"
      },
      "evidence": "tests/component-contracts.spec.ts#radio-group"
    },
    "select": {
      "semantics": ["role=combobox", "name=required", "popup=listbox", "items=option", "trigger.aria-expanded=state"],
      "keyboardInteractions": [
        { "keys": ["ArrowDown", "ArrowUp", "Enter", "Space"], "outcome": "Open and navigate available options" },
        { "keys": ["Enter", "Space"], "outcome": "Commit the highlighted option" },
        { "keys": ["Escape"], "outcome": "Close without changing the committed value" }
      ],
      "focusManagement": ["Keep DOM focus on the trigger while using active descendant navigation", "Restore focus to the trigger after close"],
      "requiredComposition": ["Provide a visible label or accessible name", "Place SelectItem instances inside SelectGroup"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/select",
        "behavior": "https://base-ui.com/react/components/select"
      },
      "evidence": "tests/component-contracts.spec.ts#select"
    },
    "switch": {
      "semantics": ["role=switch", "name=required", "aria-checked=state"],
      "keyboardInteractions": [
        { "keys": ["Space"], "outcome": "Toggle the checked state" }
      ],
      "focusManagement": ["Keep focus on the control after toggling", "Expose a visible focus indicator"],
      "requiredComposition": ["Associate a visible label or provide an accessible name", "Use for immediate binary settings rather than form submission choices"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/switch",
        "behavior": "https://base-ui.com/react/components/switch"
      },
      "evidence": "tests/component-contracts.spec.ts#switch"
    },
    "tabs": {
      "semantics": ["role=tablist", "items=tab", "panels=tabpanel", "aria-selected=state"],
      "keyboardInteractions": [
        { "keys": ["ArrowRight", "ArrowLeft"], "outcome": "Move focus to the next or previous horizontal tab" },
        { "keys": ["Home", "End"], "outcome": "Move focus to the first or last tab" },
        { "keys": ["Enter", "Space"], "outcome": "Activate the focused tab in manual activation mode" }
      ],
      "focusManagement": ["Use roving focus within the tab list", "Keep each tab associated with its panel"],
      "requiredComposition": ["Place TabsTrigger instances inside TabsList", "Provide a TabsContent panel for each tab value"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/tabs",
        "behavior": "https://base-ui.com/react/components/tabs"
      },
      "evidence": "tests/component-contracts.spec.ts#tabs"
    },
    "tooltip": {
      "semantics": ["visual-supplement=true", "trigger.name=required", "assistive-technology-dependency=forbidden", "interactive-content=forbidden"],
      "keyboardInteractions": [
        { "keys": ["Tab"], "outcome": "Show when the trigger receives keyboard focus" },
        { "keys": ["Escape"], "outcome": "Dismiss without moving trigger focus" }
      ],
      "focusManagement": ["Never move focus into the tooltip", "Keep focus on the trigger while visible"],
      "requiredComposition": ["Give the trigger an accessible name that matches its purpose", "Use only for supplementary non-interactive information", "Keep essential information available outside the tooltip"],
      "upstream": {
        "shadcn": "https://ui.shadcn.com/docs/components/base/tooltip",
        "behavior": "https://base-ui.com/react/components/tooltip"
      },
      "evidence": "tests/component-contracts.spec.ts#tooltip"
    }
  }
}
