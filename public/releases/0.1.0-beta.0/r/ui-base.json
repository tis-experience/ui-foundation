  "css": {
    ":root, [data-ui-density=\"comfortable\"]": {
      "--ui-control-height-sm": "2rem",
      "--ui-control-height-md": "2.5rem",
      "--ui-control-height-lg": "3rem",
      "--ui-control-padding-inline-sm": "0.75rem",
      "--ui-control-padding-inline-md": "1rem",
      "--ui-control-padding-inline-lg": "1.25rem",
      "--ui-control-gap-sm": "0.375rem",
      "--ui-control-gap-md": "0.5rem",
      "--ui-control-gap-lg": "0.5rem",
      "--ui-control-font-size-sm": "0.875rem",
      "--ui-control-font-size-md": "0.875rem",
      "--ui-control-font-size-lg": "1rem",
      "--ui-control-icon-size-sm": "1rem",
      "--ui-control-icon-size-md": "1.125rem",
      "--ui-control-icon-size-lg": "1.25rem"
    },
    "[data-ui-density=\"compact\"]": {
      "--ui-control-height-sm": "1.75rem",
      "--ui-control-height-md": "2rem",
      "--ui-control-height-lg": "2.25rem",
      "--ui-control-padding-inline-sm": "0.625rem",
      "--ui-control-padding-inline-md": "0.75rem",
      "--ui-control-padding-inline-lg": "1rem",
      "--ui-control-gap-sm": "0.25rem",
      "--ui-control-gap-md": "0.375rem",
      "--ui-control-gap-lg": "0.375rem",
      "--ui-control-font-size-sm": "0.75rem",
      "--ui-control-font-size-md": "0.875rem",
      "--ui-control-font-size-lg": "0.875rem",
      "--ui-control-icon-size-sm": "0.875rem",
      "--ui-control-icon-size-md": "1rem",
      "--ui-control-icon-size-lg": "1.125rem"
    },
    "[data-ui-density=\"spacious\"]": {
      "--ui-control-height-sm": "2.5rem",
      "--ui-control-height-md": "3rem",
      "--ui-control-height-lg": "3.5rem",
      "--ui-control-padding-inline-sm": "1rem",
      "--ui-control-padding-inline-md": "1.25rem",
      "--ui-control-padding-inline-lg": "1.5rem",
      "--ui-control-gap-sm": "0.5rem",
      "--ui-control-gap-md": "0.5rem",
      "--ui-control-gap-lg": "0.75rem",
      "--ui-control-font-size-sm": "0.875rem",
      "--ui-control-font-size-md": "1rem",
      "--ui-control-font-size-lg": "1.125rem",
      "--ui-control-icon-size-sm": "1.125rem",
      "--ui-control-icon-size-md": "1.25rem",
      "--ui-control-icon-size-lg": "1.5rem"
    },
    "*": {
      "outline-color": "var(--focus-ring-color, var(--ring))"
    },
    ":where([data-slot]), :where([data-slot] button, [data-slot] a, [data-slot] input, [data-slot] textarea, [data-slot] select, [data-slot] [tabindex]:not([tabindex=\"-1\"]))": {
      "outline-color": "var(--focus-ring-color, var(--ring))",
      "outline-offset": "var(--focus-ring-offset)",
      "outline-width": "var(--focus-ring-width)"
    },
    ":where([data-slot]):focus-visible:not([data-slot=\"input-group-control\"], [data-slot=\"combobox-input\"], [data-slot=\"message-scroller-viewport\"], [data-slot=\"resizable-handle\"])": {
      "--tw-ring-offset-shadow": "0 0 #0000 !important",
      "--tw-ring-shadow": "0 0 #0000 !important",
      "outline-color": "var(--focus-ring-color, var(--ring)) !important",
      "outline-offset": "var(--focus-ring-offset) !important",
      "outline-style": "solid !important",
      "outline-width": "var(--focus-ring-width) !important"
    },
    ":where([data-slot] button, [data-slot] a, [data-slot] input, [data-slot] textarea, [data-slot] select, [data-slot] [tabindex]:not([tabindex=\"-1\"])):focus-visible:not([data-slot=\"input-group-control\"], [data-slot=\"combobox-input\"], [data-slot=\"message-scroller-viewport\"], [data-slot=\"resizable-handle\"])": {
      "--tw-ring-offset-shadow": "0 0 #0000 !important",
      "--tw-ring-shadow": "0 0 #0000 !important",
      "outline-color": "var(--focus-ring-color, var(--ring)) !important",
      "outline-offset": "var(--focus-ring-offset) !important",
      "outline-style": "solid !important",
      "outline-width": "var(--focus-ring-width) !important"
    },
    ":where([data-slot=\"input-group\"]):has([data-slot=\"input-group-control\"]:focus-visible), :where([data-slot=\"combobox-chips\"]):focus-within, :where([data-slot=\"questionnaire-choice\"]):has(input:focus-visible), :where([data-slot=\"message-scroller\"]):has([data-slot=\"message-scroller-viewport\"]:focus-visible), :where([data-slot=\"resizable-panel-group\"]):has([data-slot=\"resizable-handle\"]:focus-visible)": {
      "--tw-ring-offset-shadow": "0 0 #0000 !important",
      "--tw-ring-shadow": "0 0 #0000 !important",
      "outline-color": "var(--focus-ring-color, var(--ring)) !important",
      "outline-offset": "var(--focus-ring-offset) !important",
      "outline-style": "solid !important",
      "outline-width": "var(--focus-ring-width) !important"
    },
    ":where([readonly], [aria-readonly=\"true\"], [data-readonly])": {
      "--focus-ring-color": "var(--muted-foreground)"
    },
    ":where([data-slot=\"input-group\"]):has([readonly], [aria-readonly=\"true\"], [data-readonly]), :where([data-slot=\"combobox-chips\"]):has([readonly], [aria-readonly=\"true\"], [data-readonly]), :where([data-slot=\"questionnaire-choice\"]):has([readonly], [aria-readonly=\"true\"], [data-readonly])": {
      "--focus-ring-color": "var(--muted-foreground)"
    },
    ":where([aria-invalid=\"true\"], [data-invalid])": {
      "--focus-ring-color": "var(--destructive)"
    },
    ":where([data-slot=\"input-group\"]):has([aria-invalid=\"true\"], [data-invalid]), :where([data-slot=\"combobox-chips\"]):has([aria-invalid=\"true\"], [data-invalid]), :where([data-slot=\"questionnaire-choice\"]):has([aria-invalid=\"true\"], [data-invalid])": {
      "--focus-ring-color": "var(--destructive)"
    },
    ":where([data-slot=\"field-label\"]):has(:focus-visible), :where([data-slot=\"attachment\"]):focus-within": {
      "--tw-ring-offset-shadow": "0 0 #0000 !important",
      "--tw-ring-shadow": "0 0 #0000 !important"
    },
    ":where([data-slot=\"message-scroller-viewport\"], [data-slot=\"resizable-handle\"]):focus-visible": {
      "--tw-ring-offset-shadow": "0 0 #0000 !important",
      "--tw-ring-shadow": "0 0 #0000 !important",
      "outline-style": "none !important"
    },
    "@media (forced-colors: active)": {
      ":where([data-slot]):focus-visible, :where([data-slot] button, [data-slot] a, [data-slot] input, [data-slot] textarea, [data-slot] select, [data-slot] [tabindex]:not([tabindex=\"-1\"])):focus-visible, :where([data-slot=\"input-group\"]):has([data-slot=\"input-group-control\"]:focus-visible), :where([data-slot=\"combobox-chips\"]):focus-within, :where([data-slot=\"questionnaire-choice\"]):has(input:focus-visible), :where([data-slot=\"message-scroller\"]):has([data-slot=\"message-scroller-viewport\"]:focus-visible), :where([data-slot=\"resizable-panel-group\"]):has([data-slot=\"resizable-handle\"]:focus-visible)": {
        "outline-color": "Highlight !important"
      }
    }
  },
  "meta": {
    "distribution": "shadcn-source",
    "behaviorEngine": "@base-ui/react@1.7.0",
    "defaultTheme": "neutral",
    "foundationTokenCount": 50,
    "defaultDensity": "comfortable",
    "densityProfiles": [
      "compact",
      "comfortable",
      "spacious"
    ]
  },
  "docs": "Neutral and Comfortable are the defaults. Set data-ui-density to compact, comfortable or spacious. Add theme-tis separately and set data-ui-theme=\"tis\" on the document root to opt into the TIS identity.",
  "type": "registry:base"
}