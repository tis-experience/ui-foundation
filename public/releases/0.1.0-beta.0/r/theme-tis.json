{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-tis",
  "title": "TIS Theme",
  "description": "Optional standalone TIS identity preset for UI Foundation.",
  "registryDependencies": [
    "https://tis-experience.github.io/ui-foundation/releases/0.1.0-beta.0/r/ui-base.json"
  ],
  "css": {
    "[data-ui-theme=\"tis\"]": {
      "--background": "#ffffff",
      "--foreground": "#101828",
      "--card": "#ffffff",
      "--card-foreground": "#101828",
      "--popover": "#ffffff",
      "--popover-foreground": "#101828",
      "--primary": "#0056e0",
      "--primary-foreground": "#ffffff",
      "--secondary": "#eaf2ff",
      "--secondary-foreground": "#003a99",
      "--muted": "#f2f4f7",
      "--muted-foreground": "#475467",
      "--overlay": "#10182833",
      "--accent": "#e6efff",
      "--accent-foreground": "#003a99",
      "--destructive": "#b42318",
      "--border": "#d0d5dd",
      "--input": "#98a2b3",
      "--ring": "#0056e0",
      "--chart-1": "#0056e0",
      "--chart-2": "#0086c9",
      "--chart-3": "#7a5af8",
      "--chart-4": "#12b76a",
      "--chart-5": "#f79009",
      "--radius": "0.625rem",
      "--sidebar": "#f8fafc",
      "--sidebar-foreground": "#101828",
      "--sidebar-primary": "#0056e0",
      "--sidebar-primary-foreground": "#ffffff",
      "--sidebar-accent": "#eaf2ff",
      "--sidebar-accent-foreground": "#003a99",
      "--sidebar-border": "#d0d5dd",
      "--sidebar-ring": "#0056e0"
    },
    ".dark[data-ui-theme=\"tis\"]": {
      "--background": "#0c111d",
      "--foreground": "#f2f4f7",
      "--card": "#161b26",
      "--card-foreground": "#f2f4f7",
      "--popover": "#161b26",
      "--popover-foreground": "#f2f4f7",
      "--primary": "#84adff",
      "--primary-foreground": "#002661",
      "--secondary": "#1d2939",
      "--secondary-foreground": "#f2f4f7",
      "--muted": "#1d2939",
      "--muted-foreground": "#98a2b3",
      "--overlay": "#000000b3",
      "--accent": "#102a56",
      "--accent-foreground": "#d1e0ff",
      "--destructive": "#f97066",
      "--border": "#344054",
      "--input": "#475467",
      "--ring": "#84adff",
      "--chart-1": "#84adff",
      "--chart-2": "#53b1fd",
      "--chart-3": "#b692f6",
      "--chart-4": "#47cd89",
      "--chart-5": "#fdb022",
      "--radius": "0.625rem",
      "--sidebar": "#161b26",
      "--sidebar-foreground": "#f2f4f7",
      "--sidebar-primary": "#84adff",
      "--sidebar-primary-foreground": "#002661",
      "--sidebar-accent": "#102a56",
      "--sidebar-accent-foreground": "#d1e0ff",
      "--sidebar-border": "#344054",
      "--sidebar-ring": "#84adff"
    }
  },
  "meta": {
    "optional": true,
    "source": "tokens/themes/tis.json"
  },
  "docs": "Apply data-ui-theme=\"tis\" to the html element. Add class=\"dark\" on the same element for dark mode. This preset has no dependency on ds-tis.",
  "type": "registry:theme"
}