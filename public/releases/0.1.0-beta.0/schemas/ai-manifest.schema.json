{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tis-experience.github.io/ui-foundation/releases/0.1.0-beta.0/schemas/ai-manifest.schema.json",
  "title": "UI Foundation AI manifest",
  "type": "object",
  "required": ["name", "version", "independence", "distribution", "theming", "foundations", "componentContracts", "rules", "blocks", "charts", "components"],
  "properties": {
    "name": { "const": "ui-foundation" },
    "version": { "type": "string" },
    "independence": { "type": "object" },
    "distribution": { "type": "object" },
    "theming": { "type": "object" },
    "foundations": {
      "type": "object",
      "required": ["source", "tokenCount", "groups"],
      "properties": {
        "source": { "const": "tokens/foundations.json" },
        "tokenCount": { "type": "integer", "minimum": 1 },
        "groups": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "componentContracts": {
      "type": "object",
      "required": ["source", "profiles", "components", "interactionTested"],
      "properties": {
        "source": { "type": "string" },
        "profiles": { "type": "integer", "minimum": 1 },
        "components": { "type": "integer", "minimum": 1 },
        "interactionTested": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "guides": { "type": "array", "items": { "type": "object" } },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "status", "category", "description", "install", "exports", "files", "accessibility"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "status": { "const": "alpha" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "install": { "type": "string" },
          "exports": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": { "type": "array", "items": { "type": "string" } },
          "accessibility": { "type": "string" }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "status", "category", "description", "install", "exports", "files", "accessibility"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "status": { "const": "alpha" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "install": { "type": "string" },
          "exports": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": { "type": "array", "items": { "type": "string" } },
          "accessibility": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "status", "category", "description", "install", "exports", "files", "accessibility", "contract"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "status": { "const": "alpha" },
          "category": { "type": "string" },
          "introducedIn": { "type": "string" },
          "description": { "type": "string" },
          "install": { "type": "string" },
          "exports": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": { "type": "array", "items": { "type": "string" } },
          "accessibility": { "type": "string" },
          "contract": {
            "type": "object",
            "required": ["profile", "source", "level"],
            "properties": {
              "profile": { "type": "string" },
              "source": { "type": "string" },
              "level": { "enum": ["profile", "interaction-tested"] }
            }
          }
        }
      }
    }
  }
}
