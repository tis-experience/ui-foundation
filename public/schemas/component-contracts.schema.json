{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tis-experience.github.io/ui-foundation/schemas/component-contracts.schema.json",
  "title": "UI Foundation component contract profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "behaviorOwner", "keyboard", "responsive", "requiredStates", "consumerResponsibilities"],
        "properties": {
          "classification": { "type": "string", "minLength": 1 },
          "behaviorOwner": { "enum": ["base-ui", "browser", "external", "library"] },
          "keyboard": { "enum": ["managed", "native", "composed", "not-applicable"] },
          "responsive": { "enum": ["intrinsic", "consumer-layout", "consumer-managed-horizontal", "scroll-contained", "viewport-constrained"] },
          "requiredStates": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "consumerResponsibilities": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
