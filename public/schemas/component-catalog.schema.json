{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tis-experience.github.io/ui-foundation/schemas/component-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "distribution", "behaviorEngine", "defaultTheme", "optionalThemes", "blocks", "charts", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "distribution": { "const": "shadcn-source" },
    "behaviorEngine": { "type": "string" },
    "defaultTheme": { "type": "string" },
    "optionalThemes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "type", "description", "components", "documentation"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["composition", "guide"] },
          "description": { "type": "string", "minLength": 1 },
          "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "documentation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "category", "description", "files", "registryDependencies", "accessibility"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "registryDependencies": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "accessibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "category", "description", "files", "registryDependencies", "accessibility"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "registryDependencies": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "accessibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "category", "description", "files", "accessibility"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "introducedIn": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "registryDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "accessibility": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
