{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tis-experience.github.io/ui-foundation/tokens/density.schema.json",
  "title": "UI Foundation density profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["default", "profiles"],
  "properties": {
    "default": { "enum": ["compact", "comfortable", "spacious"] },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md", "lg"],
      "properties": {
        "sm": { "type": "string", "minLength": 1 },
        "md": { "type": "string", "minLength": 1 },
        "lg": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "description", "control"],
      "properties": {
        "name": { "enum": ["compact", "comfortable", "spacious"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "paddingInline", "gap", "fontSize", "iconSize"],
          "properties": {
            "height": { "$ref": "#/$defs/scale" },
            "paddingInline": { "$ref": "#/$defs/scale" },
            "gap": { "$ref": "#/$defs/scale" },
            "fontSize": { "$ref": "#/$defs/scale" },
            "iconSize": { "$ref": "#/$defs/scale" }
          }
        }
      }
    }
  }
}
