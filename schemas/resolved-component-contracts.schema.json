{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tis-experience.github.io/ui-foundation/schemas/resolved-component-contracts.schema.json",
  "title": "UI Foundation resolved component contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "category", "profile", "classification", "behaviorOwner", "keyboard", "responsive", "requiredStates", "consumerResponsibilities", "accessibility"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "profile": { "type": "string" },
          "classification": { "type": "string" },
          "behaviorOwner": { "enum": ["base-ui", "browser", "external", "library"] },
          "keyboard": { "enum": ["managed", "native", "composed", "not-applicable"] },
          "responsive": { "enum": ["intrinsic", "consumer-layout", "consumer-managed-horizontal", "scroll-contained", "viewport-constrained"] },
          "requiredStates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "consumerResponsibilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "accessibility": { "type": "string" }
        }
      }
    }
  }
}
